+// [obsidian-learning patch] helpers — see obsidian-learning/docs/UPSTREAM-PATCHES.md
+function leadingFrontmatter(text: string): string {
+	const m = /^---\r?\n[\s\S]*?\r?\n---\r?\n/.exec(text);
+	return m ? m[0] + "\n" : "";
+}
+function isLinkableTarget(text: string): boolean {
+	const body = text.slice(leadingFrontmatter(text).trimEnd().length).trim();
+	if (body.length === 0) return true; // empty note (frontmatter allowed)
+	if (/^type:\s*learning-transcript\s*$/m.test(leadingFrontmatter(text))) return true;
+	return body.startsWith("> [!quote] YOU") || body.startsWith("> [!abstract] PI");
+}
+
 export default function mdLog(pi: ExtensionAPI) {
 	let logFile: string | null = null;
 
